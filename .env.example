# Run npm run setup to create a random local secret.
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase pooled Postgres connection (production). Omit for local SQLite.
DATABASE_URL=
# Direct/session connection used only for database migrations.
DATABASE_MIGRATION_URL=
# Set to 1 ONLY while intentionally generating Postgres migrations locally.
GENERATE_POSTGRES_MIGRATIONS=

# Supabase Storage S3 credentials, all server-side only.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=lookback-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Example: https://PROJECT.supabase.co/storage/v1/object/public/lookback-media
MEDIA_PUBLIC_URL=

# Optional one-time admin bootstrap. Never commit these values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
